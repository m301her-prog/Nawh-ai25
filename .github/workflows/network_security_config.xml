<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- منع حركة المرور عبر HTTP للنطاق المحدد -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">nawh-ai25.vercel.app</domain>
        <trust-anchors>
            <certificates src="system" />
            <!-- الخيار التالي مفيد إذا كنت تستخدم شهادات مخصصة أو للبيئة التطويرية -->
            <certificates src="user" />
        </trust-anchors>
    </domain-config>
</network-security-config>
